# IHSG Screener - Apache Configuration
# Place this file in your project root directory

# Enable RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Force HTTPS (uncomment for production)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Remove .php extension from URLs
    RewriteRule ^([a-zA-Z0-9_-]+)$ $1.php [L]
    
    # Prevent direct access to PHP files
    RewriteRule ^(config|database|api|vendor|\.git)/ - [F,L]
    
    # Redirect missing files/directories to index.html for SPA
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    
    # CSS & JS
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    
    # HTML
    ExpiresByType text/html "access plus 0 seconds"
    
    # Default
    ExpiresDefault "access plus 2 days"
</IfModule>

# CORS Headers
<IfModule mod_headers.c>
    # Allow CORS for fonts
    <FilesMatch "\.(ttf|otf|eot|woff|woff2)$">
        Header add Access-Control-Allow-Origin "*"
    </FilesMatch>
    
    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Disable server signature
    Header unset Server
</IfModule>

# PHP Configuration (jika menggunakan .htaccess)
<IfModule mod_php7.c>
    # Max upload size
    php_value upload_max_filesize 50M
    php_value post_max_size 50M
    
    # Session timeout
    php_value session.gc_maxlifetime 2592000
    
    # Error reporting
    php_value error_reporting E_ALL
    php_value display_errors Off
</IfModule>

# Disable directory listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Block common attack patterns
<IfModule mod_rewrite.c>
    # Block SQL injection attempts
    RewriteRule "(\.\./)" - [F]
    RewriteRule "([a-z0-9]{2,})(\*|'|(--)|;|\/\*|\*\/)" - [F]
    
    # Block access to sensitive files
    RewriteRule "^\.htaccess$" - [F]
    RewriteRule "^\.git" - [F]
    RewriteRule "^\.env$" - [F]
    RewriteRule "^README" - [F]
    RewriteRule "^package\.json" - [F]
    RewriteRule "^composer\.json" - [F]
</IfModule>

# Charset
AddDefaultCharset UTF-8

# Remove ETag
<IfModule mod_headers.c>
    Header unset ETag
    FileETag none
</IfModule>
